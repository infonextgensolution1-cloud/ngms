{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ngms-admin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAX_UPLOAD_BYTES": "10485760",
    "CMS_WRITE_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ngms-admin",
      "database_id": "12f7ab7e-adf6-4eb4-a118-29c4ab94cd41"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ngmsmedia"
    }
  ]
}
