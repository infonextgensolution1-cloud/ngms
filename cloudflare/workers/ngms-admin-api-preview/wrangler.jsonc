{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ngms-admin-api-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "MAX_UPLOAD_BYTES": "10485760",
    "CMS_WRITE_ENABLED": "false",
    "CF_ACCESS_TEAM_DOMAIN": "https://shiny-wood-b438.cloudflareaccess.com",
    "CF_ACCESS_AUD": "6dd6ecc7ba60b1f60a13959064fb091afc3a0262d96b8f1c026cdb0141357459"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ngms-admin-preview",
      "database_id": "f12c5c48-58cd-4c48-82de-8c7341b8e6cf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ngmsmedia-preview"
    }
  ]
}
