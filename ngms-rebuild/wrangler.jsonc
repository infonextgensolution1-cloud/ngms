{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ngms-rebuild-preview-worker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_NGMS_API_BASE": "https://ngms-admin-api-preview.nextgensolarcleaningmaintenancesolutions.workers.dev"
  }
}
