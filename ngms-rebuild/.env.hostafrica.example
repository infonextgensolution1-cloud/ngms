# Configure these as server-side variables in the DirectAdmin Node.js application.
# Never commit real passwords, tokens or credentials.

NODE_ENV=production
PORT=3000
BIND_ADDRESS=0.0.0.0
APP_BASE_URL=https://nextgen.getmaintenance.co.za

DB_HOST=localhost
DB_PORT=3306
DB_NAME=REPLACE_WITH_DIRECTADMIN_DATABASE_NAME
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DB_POOL_SIZE=5

# Generate with: openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
# Generate separately with: openssl rand -hex 32
NGMS_SETUP_TOKEN=REPLACE_WITH_ONE_TIME_ADMIN_BOOTSTRAP_TOKEN

# Use an absolute writable path outside public_html, e.g.
# /home/ACCOUNT/domains/nextgen.getmaintenance.co.za/private/ngms-media
MEDIA_ROOT=/home/ACCOUNT/domains/nextgen.getmaintenance.co.za/private/ngms-media

# Optional SMTP settings for transactional notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
